{
  "task": "response_v1_1_adapter",
  "base_model": "google/gemma-4-12B-it",
  "quantization": "nf4_4bit",
  "max_length": 4096,
  "epochs": 4,
  "learning_rate": 0.00005,
  "scheduler": "cosine",
  "warmup_ratio": 0.03,
  "weight_decay": 0.01,
  "optimizer": "paged_adamw_8bit",
  "train_batch_size": 1,
  "eval_batch_size": 1,
  "gradient_accumulation_steps": 16,
  "gradient_clipping": 1.0,
  "bf16": true,
  "tf32": true,
  "gradient_checkpointing": true,
  "seed": 42,
  "lora": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0.05,
    "bias": "none",
    "target": "Gemma language decoder attention and MLP projections"
  },
  "checkpoint": {
    "save_strategy": "epoch",
    "evaluation_strategy": "epoch",
    "save_each_epoch": true,
    "resume_contract": "output-dir-v1"
  }
}
